# Server
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# JWT — use a long random string in production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Cookie (set COOKIE_SECURE=true behind HTTPS in production)
COOKIE_NAME=seni_token
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Database: 'sqlite3' (zero-config, local file), 'pg' (PostgreSQL), or 'mysql2' (MySQL)
# ---------------------------------------------------------------------------

# --- SQLite (default, zero configuration needed) ---
DB_CLIENT=sqlite3
DB_FILENAME=seni_chat.sqlite

# --- PostgreSQL ---
# DB_CLIENT=pg
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=seni_chat
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password

# --- MySQL ---
# DB_CLIENT=mysql2
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=seni_chat
# DB_USER=root
# DB_PASSWORD=your_mysql_password
